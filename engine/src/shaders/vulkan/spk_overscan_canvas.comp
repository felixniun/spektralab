#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=256) in;
layout(set=0,binding=0,std430) readonly buffer Frame { float rgb[]; };
layout(set=0,binding=2,std430) readonly buffer Count { uint n[]; };
layout(set=0,binding=3,std430) writeonly buffer Output { float out_rgb[]; };
#include "spk_overscan_common.glsl"

uint spk_global_index() { return gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x; }

vec3 sample_input_frame(float fx, float fy) {
    uint fw = uint(p[P_FW]), fh = uint(p[P_FH]);
    fx = clamp(fx, 0.0, float(fw) - 1.0); fy = clamp(fy, 0.0, float(fh) - 1.0);
    uint x0 = uint(floor(fx)), y0 = uint(floor(fy));
    uint x1 = min(x0 + 1u, fw - 1u), y1 = min(y0 + 1u, fh - 1u);
    float ax = fx - float(x0), ay = fy - float(y0);
    uint i00 = 3u * (y0 * fw + x0), i01 = 3u * (y0 * fw + x1);
    uint i10 = 3u * (y1 * fw + x0), i11 = 3u * (y1 * fw + x1);
    vec3 a = vec3(rgb[i00], rgb[i00 + 1u], rgb[i00 + 2u]);
    vec3 b = vec3(rgb[i01], rgb[i01 + 1u], rgb[i01 + 2u]);
    vec3 c = vec3(rgb[i10], rgb[i10 + 1u], rgb[i10 + 2u]);
    vec3 d = vec3(rgb[i11], rgb[i11 + 1u], rgb[i11 + 2u]);
    return sample_frame(a, b, c, d, ax, ay);
}

void main() {
    uint i = spk_global_index(); if (i >= n[0]) return;
    uint cw = uint(p[P_CW]);
    vec2 st = canvas_to_film(float(i % cw), float(i / cw));
    float width = p[P_FILM_W]; vec3 e = vec3(0.0);
    if (p[P_CARRIER] > 1.5 || (st.y >= 0.0 && st.y <= width)) {
        vec2 sg = st; float shift = 0.0;
        if (p[P_PAIR_ADV] > 0.0 && st.x > p[P_GS0] + 0.5 * (p[P_GW] + p[P_PAIR_ADV])) { shift = p[P_PAIR_ADV]; sg.x -= shift; }
        float cov = penumbra(gate_sdf(sg), p[P_PENUMBRA]);
        if (cov > 0.0) {
            float px = p[P_PX]; float fx, fy;
            if (p[P_VERTICAL] < 0.5) { fx = (st.x - p[P_GS0]) / px - 0.5; fy = (st.y - p[P_GT0]) / px - 0.5; }
            else { fx = (p[P_GT0] + p[P_GH] - st.y) / px - 0.5; fy = (st.x - p[P_GS0]) / px - 0.5; }
            e += cov * sample_input_frame(fx, fy);
        }
        float d_gate = gate_sdf(sg);
        if (p[P_FLARE_AMP] > 0.0 && d_gate > -0.02 && d_gate < 6.0 * p[P_FLARE_WIDTH]) {
            float px = p[P_PX];
            float in_s = clamp(sg.x, p[P_GS0] + 0.12, p[P_GS0] + p[P_GW] - 0.12) + shift;
            float in_t = clamp(st.y, p[P_GT0] + 0.12, p[P_GT0] + p[P_GH] - 0.12);
            float fx, fy;
            if (p[P_VERTICAL] < 0.5) { fx = (in_s - p[P_GS0]) / px - 0.5; fy = (in_t - p[P_GT0]) / px - 0.5; }
            else { fx = (p[P_GT0] + p[P_GH] - in_t) / px - 0.5; fy = (in_s - p[P_GS0]) / px - 0.5; }
            e += p[P_FLARE_AMP] * exp(-max(d_gate, 0.0) / p[P_FLARE_WIDTH]) * sample_input_frame(fx, fy);
        }
        float d_top = max(st.y, 0.0), d_bot = max(width - st.y, 0.0);
        uint seed = uint(p[P_FOG_SEED]); float period = max(p[P_FOG_PERIOD], 0.1);
        float nz = 0.6 * value_noise(st.x / period, seed) + 0.4 * value_noise(st.x / (0.37 * period), seed ^ 0xA5A5A5A5u);
        float fog = p[P_FOG_AMP] * exp(-min(d_top, d_bot) / max(p[P_FOG_WIDTH], 1e-3)) * (0.3 + 0.7 * nz);
        uint nl = uint(p[P_N_LEAKS]);
        for (uint k = 0u; k < nl; ++k) {
            uint b = P_LEAKS + 5u * k; float dd = p[b + 1u] < 0.5 ? d_top : d_bot;
            float ds = st.x - p[b]; fog += p[b + 2u] * exp(-ds * ds / (2.0 * p[b + 3u] * p[b + 3u])) * exp(-dd / p[b + 4u]);
        }
        e += fog * vec3(p[P_FOG_R], p[P_FOG_G], p[P_FOG_B]);
    }
    out_rgb[3u * i] = e.x; out_rgb[3u * i + 1u] = e.y; out_rgb[3u * i + 2u] = e.z;
}
